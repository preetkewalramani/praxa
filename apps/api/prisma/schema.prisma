generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Firm {
  id         String    @id @default(cuid()) @map("id")
  name       String    @map("name")
  slug       String    @unique @map("slug")
  status     String    @default("ACTIVE") @map("status")
  logoUrl    String?   @map("logo_url")
  timezone   String?   @map("timezone")
  currency   String?   @map("currency")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  users      User[]
  roles      Role[]
  userRoles  UserRole[]
  sessions   Session[]
  rolePerms  RolePermission[]
  auditLogs  AuditLog[]

  @@map("firms")
}

model User {
  id           String    @id @default(cuid()) @map("id")
  firmId       String    @map("firm_id")
  email        String    @map("email")
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  firm         Firm      @relation(fields: [firmId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  sessions     Session[]

  @@unique([firmId, email], map: "uq_users_firm_email")
  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid()) @map("id")
  firmId     String   @map("firm_id")
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  action     String   @map("action")
  payload    Json     @map("payload")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

model Role {
  id          String           @id @default(cuid()) @map("id")
  firmId      String           @map("firm_id")
  name        String           @map("name")
  description String?          @map("description")
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Restrict)
  userRoles   UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([firmId, name], map: "uq_roles_firm_name")
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid()) @map("id")
  name        String           @unique @map("name")
  description String?          @map("description")
  resource    String           @map("resource")
  action      String           @map("action")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  rolePerms   RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid()) @map("id")
  firmId    String   @map("firm_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([firmId, userId, roleId], map: "uq_user_roles")
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid()) @map("id")
  firmId       String     @map("firm_id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  firm         Firm       @relation(fields: [firmId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([firmId, roleId, permissionId], map: "uq_role_permissions")
  @@map("role_permissions")
}

model Session {
  id               String   @id @default(cuid()) @map("id")
  firmId           String   @map("firm_id")
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  firm             Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("sessions")
}


model Invitation {
  id        String    @id @default(cuid()) @map("id")
  firmId    String    @map("firm_id")
  email     String    @map("email")
  roleId    String    @map("role_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt DateTime? @map("revoked_at")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([firmId, email], map: "idx_invitations_firm_email")
  @@map("invitations")
}


enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ARCHIVED
}

model Client {
  id          String       @id @default(cuid()) @map("id")
  firmId      String       @map("firm_id")
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  companyName String       @map("company_name")
  email       String       @map("email")
  phone       String       @map("phone")
  status      ClientStatus @default(ACTIVE) @map("status")
  notes       String?      @map("notes")
  createdBy   String?      @map("created_by")
  updatedBy   String?      @map("updated_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  tagLinks    ClientTagAssignment[]
  projects    Project[]

  @@index([firmId, email], map: "idx_clients_firm_email")
  @@index([firmId, companyName], map: "idx_clients_firm_company")
  @@map("clients")
}

model ClientTag {
  id        String   @id @default(cuid()) @map("id")
  firmId    String   @map("firm_id")
  name      String   @map("name")
  color     String   @map("color")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  links     ClientTagAssignment[]

  @@unique([firmId, name], map: "uq_client_tags_firm_name")
  @@map("client_tags")
}

model ClientTagAssignment {
  id        String   @id @default(cuid()) @map("id")
  firmId    String   @map("firm_id")
  clientId  String   @map("client_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tag       ClientTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([firmId, clientId, tagId], map: "uq_client_tag_assignments")
  @@map("client_tag_assignments")
}


enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model ServiceCategory {
  id          String   @id @default(cuid()) @map("id")
  firmId      String   @map("firm_id")
  name        String   @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  services    Service[]

  @@unique([firmId, name], map: "uq_service_categories_firm_name")
  @@map("service_categories")
}

model Service {
  id                     String        @id @default(cuid()) @map("id")
  firmId                 String        @map("firm_id")
  categoryId             String        @map("category_id")
  code                   String        @map("code")
  name                   String        @map("name")
  description            String?       @map("description")
  status                 ServiceStatus @default(ACTIVE) @map("status")
  defaultDurationMinutes Int           @map("default_duration_minutes")
  createdBy              String?       @map("created_by")
  updatedBy              String?       @map("updated_by")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  deletedAt              DateTime?     @map("deleted_at")
  category               ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices                 ServicePrice[]
  projectServices        ProjectService[]
  workOrders             WorkOrder[]

  @@unique([firmId, code], map: "uq_services_firm_code")
  @@map("services")
}

model ServicePrice {
  id            String   @id @default(cuid()) @map("id")
  firmId        String   @map("firm_id")
  serviceId     String   @map("service_id")
  amount        Decimal  @db.Decimal(12, 2) @map("amount")
  currency      String   @map("currency")
  effectiveFrom DateTime @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isCurrent     Boolean  @default(true) @map("is_current")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([firmId, serviceId, isCurrent], map: "idx_service_prices_current")
  @@map("service_prices")
}


enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Project {
  id            String        @id @default(cuid()) @map("id")
  firmId        String        @map("firm_id")
  clientId      String        @map("client_id")
  code          String        @map("code")
  name          String        @map("name")
  description   String?       @map("description")
  status        ProjectStatus @default(DRAFT) @map("status")
  startDate     DateTime?     @map("start_date")
  targetEndDate DateTime?     @map("target_end_date")
  actualEndDate DateTime?     @map("actual_end_date")
  createdBy     String?       @map("created_by")
  updatedBy     String?       @map("updated_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  services      ProjectService[]
  workOrders    WorkOrder[]

  @@unique([firmId, code], map: "uq_projects_firm_code")
  @@map("projects")
}

model ProjectService {
  id         String   @id @default(cuid()) @map("id")
  firmId     String   @map("firm_id")
  projectId  String   @map("project_id")
  serviceId  String   @map("service_id")
  quantity   Int      @map("quantity")
  unitPrice  Decimal  @db.Decimal(12,2) @map("unit_price")
  totalPrice Decimal  @db.Decimal(12,2) @map("total_price")
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([firmId, projectId, serviceId], map: "uq_project_services")
  @@map("project_services")
}

model WorkOrder {
  id          String            @id @default(cuid()) @map("id")
  firmId      String            @map("firm_id")
  projectId   String            @map("project_id")
  serviceId   String            @map("service_id")
  code        String            @map("code")
  title       String            @map("title")
  description String?           @map("description")
  status      WorkOrderStatus   @default(OPEN) @map("status")
  priority    WorkOrderPriority @default(MEDIUM) @map("priority")
  assignedTo  String?           @map("assigned_to")
  startedAt   DateTime?         @map("started_at")
  completedAt DateTime?         @map("completed_at")
  dueDate     DateTime?         @map("due_date")
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  events      WorkOrderEvent[]

  @@unique([firmId, code], map: "uq_work_orders_firm_code")
  @@map("work_orders")
}

model WorkOrderEvent {
  id          String   @id @default(cuid()) @map("id")
  firmId      String   @map("firm_id")
  workOrderId String   @map("work_order_id")
  eventType   String   @map("event_type")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  actorId     String?  @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@map("work_order_events")
}
