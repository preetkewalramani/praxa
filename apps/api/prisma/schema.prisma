generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Firm {
  id         String    @id @default(cuid()) @map("id")
  name       String    @map("name")
  slug       String    @unique @map("slug")
  status     String    @default("ACTIVE") @map("status")
  logoUrl    String?   @map("logo_url")
  timezone   String?   @map("timezone")
  currency   String?   @map("currency")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  users      User[]
  roles      Role[]
  userRoles  UserRole[]
  sessions   Session[]
  rolePerms  RolePermission[]
  auditLogs  AuditLog[]

  @@map("firms")
}

model User {
  id           String    @id @default(cuid()) @map("id")
  firmId       String    @map("firm_id")
  email        String    @map("email")
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  firm         Firm      @relation(fields: [firmId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  sessions     Session[]

  @@unique([firmId, email], map: "uq_users_firm_email")
  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid()) @map("id")
  firmId     String   @map("firm_id")
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  action     String   @map("action")
  payload    Json     @map("payload")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

model Role {
  id          String           @id @default(cuid()) @map("id")
  firmId      String           @map("firm_id")
  name        String           @map("name")
  description String?          @map("description")
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Restrict)
  userRoles   UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([firmId, name], map: "uq_roles_firm_name")
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid()) @map("id")
  name        String           @unique @map("name")
  description String?          @map("description")
  resource    String           @map("resource")
  action      String           @map("action")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  rolePerms   RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid()) @map("id")
  firmId    String   @map("firm_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([firmId, userId, roleId], map: "uq_user_roles")
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid()) @map("id")
  firmId       String     @map("firm_id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  firm         Firm       @relation(fields: [firmId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([firmId, roleId, permissionId], map: "uq_role_permissions")
  @@map("role_permissions")
}

model Session {
  id               String   @id @default(cuid()) @map("id")
  firmId           String   @map("firm_id")
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  firm             Firm     @relation(fields: [firmId], references: [id], onDelete: Restrict)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("sessions")
}


model Invitation {
  id        String    @id @default(cuid()) @map("id")
  firmId    String    @map("firm_id")
  email     String    @map("email")
  roleId    String    @map("role_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt DateTime? @map("revoked_at")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([firmId, email], map: "idx_invitations_firm_email")
  @@map("invitations")
}
