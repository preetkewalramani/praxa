{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.example", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "API_PORT", "WEB_PORT", "DATABASE_URL", "REDIS_HOST", "REDIS_PORT"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", ".vite/**", "!.vite/cache/**", "tsconfig.tsbuildinfo"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["tsconfig.tsbuildinfo", "*.tsbuildinfo"]
    }
  }
}
